# Server only. Copy this file to .env at the repository root.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SEMESTEROS_API
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SEMESTEROS_BACKEND
SNOWFLAKE_PRIVATE_KEY_FILE=
# Optional passphrase for an encrypted PKCS#8 private key.
SNOWFLAKE_PRIVATE_KEY_PASSWORD=

# Gemini Developer API, server only. Keep the key out of VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
